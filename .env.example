# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/goodscores/backend/public
APP_BASE_PATH=/goodscores/backend/public
FRONTEND_URL=http://localhost/goodscores
CORS_ALLOWED_ORIGINS=http://localhost/goodscores
JWT_SECRET=replace-with-a-long-random-secret

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=question_bank
DB_USER=root
DB_PASS=

# Optional AI/OCR configuration
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GOOGLE_VISION_API_KEY=

# Optional Paystack configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost/goodscores
